<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.b3dgs.lionengine</groupId>
        <artifactId>lionengine</artifactId>
        <version>11.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>lionengine-audio-codec-ogg</artifactId>
    <packaging>jar</packaging>
    <name>LionEngine Audio Codec OGG</name>
    <description>Desktop OGG Vorbis decoder on JOrbis</description>
    <properties>
        <!-- Desktop-only module: Java 25 class files are allowed (ADR-0044); excluded from Android builds, where the
             platform decodes OGG Vorbis (ADR-0033, ADR-0073). -->
        <jdk.version>25</jdk.version>
        <radial.base-package>com.b3dgs.lionengine.audio.codec.ogg</radial.base-package>
    </properties>
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-audio-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- ADR-0032, ADR-0033, ADR-0073: pure Java OGG Vorbis decoder, LGPL-2.0-or-later, no dependency of its own;
             recorded in docs/dependencies.md. Only this module may use it. -->
        <dependency>
            <groupId>org.jcraft</groupId>
            <artifactId>jorbis</artifactId>
            <version>0.0.17</version>
        </dependency>
        <!-- ADR-0045: the AudioDecoderContract suite, FakeAudioBackend and WavWriter of the audio-api test JAR. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-audio-api</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- ADR-0045: the inbox spy of the core test JAR. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- ADR-0045: the fake resource provider of the resources test JAR. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-resources</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
