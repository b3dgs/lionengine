<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.b3dgs</groupId>
        <artifactId>b3dgs-parent</artifactId>
        <version>3.0.0-SNAPSHOT</version>
        <relativePath />
    </parent>
    <groupId>com.b3dgs.lionengine</groupId>
    <artifactId>lionengine</artifactId>
    <version>11.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>LionEngine</name>
    <description>Java 2D Game Engine</description>
    <url>https://github.com/b3dgs/lionengine</url>
    <modules>
        <module>lionengine-core</module>
        <module>lionengine-runtime</module>
        <module>lionengine-resources</module>
        <module>lionengine-resources-file</module>
        <module>lionengine-resources-archive</module>
        <module>lionengine-resources-memory</module>
        <module>lionengine-render-api</module>
        <module>lionengine-platform-api</module>
        <module>lionengine-audio-api</module>
        <module>lionengine-graphics</module>
        <module>lionengine-physics</module>
        <module>lionengine-tilemap</module>
        <module>lionengine-camera</module>
        <module>lionengine-input-api</module>
        <module>lionengine-ecs</module>
        <module>lionengine-traits</module>
        <module>lionengine-composition</module>
        <module>lionengine-test-support</module>
        <module>lionengine-platform-awt</module>
        <module>lionengine-render-awt</module>
        <module>lionengine-input-awt</module>
        <module>lionengine-audio-javasound</module>
        <module>lionengine-graphics-imageio</module>
        <module>lionengine-examples</module>
    </modules>
    <scm>
        <url>https://github.com/b3dgs/lionengine</url>
        <connection>scm:git:git@github.com:b3dgs/lionengine.git</connection>
        <developerConnection>scm:git:git@github.com:b3dgs/lionengine.git</developerConnection>
        <tag>HEAD</tag>
    </scm>
    <properties>
        <!-- Shared modules: Java 21 class files (ADR-0044); desktop-only modules override it with 25. -->
        <jdk.version>21</jdk.version>
        <!-- Overridden by every module with its own root package (ADR-0037). -->
        <radial.base-package>com.b3dgs.lionengine</radial.base-package>
        <build-jdk.minimum>25</build-jdk.minimum>
        <!-- ADR-0050: the latest stable JUnit release, pinned here whatever the parent provides. -->
        <junit.version>6.1.3</junit.version>
        <!-- Sonar S1711 asks for java.util.function instead of an engine callback interface; that package is not on
             Android API 21 and is banned from shared public APIs (ADR-0037, docs/android-compatibility.md). -->
        <sonar.issue.ignore.multicriteria>s1711</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.s1711.ruleKey>java:S1711</sonar.issue.ignore.multicriteria.s1711.ruleKey>
        <sonar.issue.ignore.multicriteria.s1711.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.s1711.resourceKey>
    </properties>
    <dependencies>
        <!-- Inherited from b3dgs-parent in compile scope: no shared module may ship a logging library
             (REQ-CORE-006, ADR-0031), so it is kept for tests only. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Inherited from b3dgs-parent in compile scope: build configuration files only (checkstyle, formatter),
             never shipped with the engine artifacts. -->
        <dependency>
            <groupId>com.b3dgs</groupId>
            <artifactId>b3dgs-buildtools</artifactId>
            <version>${b3dgs.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <!-- Needed to resolve the snapshot parent itself (ADR-0051); the parent declares the same repository for the
         rest of the build. Removed when the parent is a release. -->
    <repositories>
        <repository>
            <id>snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <!-- REQ-CORE-003, ADR-0032: every public and protected member documented, tags included. -->
                        <doclint>all</doclint>
                        <failOnWarnings>true</failOnWarnings>
                        <failOnError>true</failOnError>
                        <quiet>true</quiet>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-jdk</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[${build-jdk.minimum},)</version>
                                    <message>Build with JDK 25 or later (REQ-TECH-001, ADR-0044).</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <!-- ADR-0045: the fakes and contract suites of a module are published as its test JAR. -->
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <archive combine.self="override" />
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.b3dgs.radialencapsulation</groupId>
                <artifactId>radial-encapsulation-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
