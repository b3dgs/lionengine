<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.b3dgs.lionengine</groupId>
        <artifactId>lionengine</artifactId>
        <version>11.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>lionengine-audio-javasound</artifactId>
    <packaging>jar</packaging>
    <name>LionEngine Audio Java Sound</name>
    <description>Desktop audio backend on Java Sound</description>
    <properties>
        <!-- Desktop-only module: Java 25 class files are allowed (ADR-0044); excluded from Android builds. -->
        <jdk.version>25</jdk.version>
        <radial.base-package>com.b3dgs.lionengine.audio.javasound</radial.base-package>
    </properties>
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-audio-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- ADR-0045: the AudioBackendContract suite and FakeAudioBackend, bound on the mixer and the backend. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-audio-api</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- ADR-0045: the inbox spy of the core test JAR, used by the suite. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
