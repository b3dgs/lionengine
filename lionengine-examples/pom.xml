<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.b3dgs.lionengine</groupId>
        <artifactId>lionengine</artifactId>
        <version>11.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>lionengine-examples</artifactId>
    <packaging>jar</packaging>
    <name>LionEngine Examples</name>
    <description>Minimal and demonstration applications, headless first, compiled and run by the build</description>
    <properties>
        <!-- The desktop examples use the desktop-only modules, whose class files are Java 25 (ADR-0044); the examples
             are never part of an Android build. -->
        <jdk.version>25</jdk.version>
        <radial.base-package>com.b3dgs.lionengine.examples</radial.base-package>
    </properties>
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-render-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-platform-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-platform-awt</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-render-awt</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-resources</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-resources-file</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-resources-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- ADR-0045: the headless application kit, for the headless game tests of the examples. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
