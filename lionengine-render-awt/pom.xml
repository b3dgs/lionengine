<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.b3dgs.lionengine</groupId>
        <artifactId>lionengine</artifactId>
        <version>11.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>lionengine-render-awt</artifactId>
    <packaging>jar</packaging>
    <name>LionEngine Render AWT</name>
    <description>AWT renderer</description>
    <properties>
        <!-- Desktop-only module: Java 25 class files are allowed (ADR-0044); excluded from Android builds. -->
        <jdk.version>25</jdk.version>
        <radial.base-package>com.b3dgs.lionengine.render.awt</radial.base-package>
        <!-- No public type yet: javadoc refuses an empty module. The batch that adds the first public type
             removes this property (REQ-CORE-003). -->
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-render-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-platform-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lionengine-platform-awt</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
